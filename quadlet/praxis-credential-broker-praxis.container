[Unit]
Description=Praxis AI gateway
Requires=praxis-credential-broker-pod.service
After=praxis-credential-broker-pod.service

[Container]
ContainerName=praxis-credential-broker-praxis
Image=ghcr.io/praxis-proxy/ai@sha256:ccd46f8772eebcbde2f41ad35c3234d23463b8314a5865083e32baf31eddd1a8
Pod=praxis-credential-broker.pod
User=65532
Group=65532
ReadOnly=true
DropCapability=all
NoNewPrivileges=true
Volume=%h/src/github/cgwalters-bot/praxis-credential-broker/praxis.yaml:/etc/praxis/praxis.yaml:ro,Z
Tmpfs=/tmp:rw,noexec,nosuid,nodev,size=64m
Exec=--config /etc/praxis/praxis.yaml

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=300s
