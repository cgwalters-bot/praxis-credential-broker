#!/usr/bin/env bash
set -euo pipefail

if podman pod exists praxis-credential-broker >/dev/null 2>&1; then
    echo "production pod is running; stop it with 'just down' before replacing secrets" >&2
    exit 1
fi
if [[ -n ${PRAXIS_API_KEY:-} ]]; then
    input=(printf '%s' "$PRAXIS_API_KEY")
elif [[ -n ${PRAXIS_API_KEY_COMMAND:-} ]]; then
    input=(bash -c "$PRAXIS_API_KEY_COMMAND")
elif [[ -t 0 ]]; then
    read -r -s -p 'PRAXIS_API_KEY: ' key
    printf '\n' >&2
    input=(printf '%s' "$key")
else
    input=(cat)
fi
"${input[@]}" |
    python3 -c 'import sys; data=sys.stdin.buffer.read(); data=data[:-1] if data.endswith(b"\n") else data; raise SystemExit("client key must be at least 32 bytes") if len(data) < 32 else (sys.stdout.buffer.write(data + b"\n"), sys.exit(0))' |
    podman secret create --replace praxis-credential-broker-client-auth - >/dev/null
bash scripts/create-agent-secret praxis-credential-broker-agent-channel
