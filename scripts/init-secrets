#!/usr/bin/env bash
# Create the internal channel secret between credential-proxy and the Codex
# provider. Clients need no secret of the broker's: Praxis authenticates
# runs by their run tokens.
set -euo pipefail
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

if podman pod exists praxis-credential-broker >/dev/null 2>&1; then
    echo "production pod is running; stop it with 'bash scripts/native-pod.sh down' before replacing secrets" >&2
    exit 1
fi
bash "$script_dir/create-agent-secret" praxis-credential-broker-agent-channel
