#!/usr/bin/env bash
# Store a Mistral API key as the Podman secret the gateway injects upstream
# on /mistral. For a plan's included usage this is the key of "Code > Vibe
# CLI" in the Mistral console's chat side, the one Vibe keeps in
# ~/.vibe/.env; a key from console.mistral.ai/api-keys is billed per token.
# The key is read from the terminal without echo, or from standard input;
# it is never taken from the environment or the command line, and never
# printed.
set -euo pipefail
secret=praxis-credential-broker-mistral-api-key

if podman pod exists praxis-credential-broker >/dev/null 2>&1; then
    echo "production pod is running; stop it with 'bash scripts/native-pod.sh down' before replacing secrets" >&2
    exit 1
fi
if [[ -t 0 ]]; then
    read -r -s -p 'Mistral API key: ' key
    printf '\n' >&2
    input=(printf '%s' "$key")
else
    input=(cat)
fi
# Validate before touching the secret, so bad input leaves an existing one
# alone. Store it without a trailing newline: Praxis injects it verbatim.
# Mistral documents no format for its keys, so only what could not be one
# is refused: nothing, more than one line, or anything but letters, digits,
# "-" and "_".
key=$("${input[@]}" |
    python3 -c 'import re,sys; data=sys.stdin.buffer.read(); data=data[:-1] if data.endswith(b"\n") else data; raise SystemExit("expected a Mistral API key, one line of 16 to 256 letters, digits, - or _; the input is not shown") if not re.fullmatch(rb"[A-Za-z0-9_-]{16,256}", data) else (sys.stdout.buffer.write(data), sys.exit(0))')
printf '%s' "$key" | podman secret create --replace "$secret" - >/dev/null
echo "Stored the Mistral API key as Podman secret $secret." >&2
