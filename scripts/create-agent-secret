#!/usr/bin/env bash
set -euo pipefail
name=${1:?secret name required}
openssl rand -hex 32 |
    python3 -c 'import re,sys; data=sys.stdin.buffer.read().rstrip(b"\n"); assert len(data) == 64 and re.fullmatch(rb"[0-9a-f]+", data), "CSPRNG output was not 64 lowercase hex bytes"; sys.stdout.buffer.write(data); sys.stdout.flush()' |
    podman secret create --replace "$name" - >/dev/null
