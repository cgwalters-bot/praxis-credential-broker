FROM registry.access.redhat.com/hi/rust:latest AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo build --release --locked -p provider-codex
FROM registry.access.redhat.com/hi/core-runtime:latest-openssl
COPY --from=build /src/target/release/provider-codex /usr/local/bin/provider-codex
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/provider-codex"]
