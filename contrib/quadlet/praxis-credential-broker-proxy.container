# credential-proxy is reachable only inside the pod, behind Praxis, which
# authenticates runs by their run tokens; so it admits what Praxis forwards.
[Unit]
Description=Praxis credential broker proxy
Requires=praxis-credential-broker-pod.service
After=praxis-credential-broker-pod.service

[Container]
ContainerName=praxis-credential-broker-proxy
Image=ghcr.io/cgwalters-bot/praxis-credential-broker-proxy:main
AutoUpdate=registry
Pod=praxis-credential-broker.pod
Environment=CLIENT_AUTH_MODE=disabled
User=65532
Group=65532
ReadOnly=true
DropCapability=all
NoNewPrivileges=true
Secret=praxis-credential-broker-agent-channel,target=/run/secrets/channel/agent-channel-key,uid=65532,gid=65532,mode=0400
Volume=praxis-credential-broker-socket.volume:/run/praxis-credentials:Z
Tmpfs=/tmp:rw,noexec,nosuid,nodev,size=64m

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=300s
