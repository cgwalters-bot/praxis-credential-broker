# Praxis with this repository's routes baked into the image. To serve
# /anthropic, add PRAXIS_ANTHROPIC_GATEWAY=enabled and the token secret in a
# drop-in; see INTERNALS.md.
[Unit]
Description=Praxis credential broker gateway
Requires=praxis-credential-broker-pod.service
After=praxis-credential-broker-pod.service

[Container]
ContainerName=praxis-credential-broker-praxis
Image=ghcr.io/cgwalters-bot/praxis-credential-broker-gateway:main
AutoUpdate=registry
Pod=praxis-credential-broker.pod
Environment=PRAXIS_ANTHROPIC_GATEWAY=disabled
User=65532
Group=65532
ReadOnly=true
DropCapability=all
NoNewPrivileges=true
Tmpfs=/tmp:rw,noexec,nosuid,nodev,size=64m
# See Containerfile.gateway: Podman still schedules the image's
# HEALTHCHECK NONE, so turn it off for the container.
PodmanArgs=--no-healthcheck

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=300s
