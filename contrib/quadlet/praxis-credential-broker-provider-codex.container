[Unit]
Description=Praxis credential broker Codex provider
Requires=praxis-credential-broker-pod.service
After=praxis-credential-broker-pod.service

[Container]
ContainerName=praxis-credential-broker-provider-codex
Image=ghcr.io/cgwalters-bot/praxis-credential-broker-provider-codex:main
AutoUpdate=registry
Pod=praxis-credential-broker.pod
Environment=CODEX_HOME=/codex-home
User=65532
Group=65532
ReadOnly=true
DropCapability=all
NoNewPrivileges=true
Secret=praxis-credential-broker-agent-channel,target=/run/secrets/channel/agent-channel-key,uid=65532,gid=65532,mode=0400
Volume=praxis-credential-broker-auth.volume:/codex-home:Z
Volume=praxis-credential-broker-socket.volume:/run/praxis-credentials:Z
Tmpfs=/tmp:rw,noexec,nosuid,nodev,size=64m

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=300s
